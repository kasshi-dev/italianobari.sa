# Local development
DATABASE_URL=file:./prisma/dev.db
PORT=3001

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# Single service with a mounted volume (Render/Railway/Fly):
# DATABASE_URL=file:/data/loyalty.db
# RUN_SEED=1
#
# Or a remote database with no volume at all (Turso, free tier available):
# DATABASE_URL=libsql://<database>-<org>.turso.tech
# TURSO_AUTH_TOKEN=<token from `turso db tokens create <database>`>
#
# Split deployment — frontend on Vercel, API on another host. Set this at
# BUILD time on Vercel (it is baked into the bundle), no trailing slash:
# VITE_API_BASE=https://italiano-bari.onrender.com
